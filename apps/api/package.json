{
  "name": "@myapp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./routers": {
      "types": "./src/routers/index.ts"
    }
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch --env-file=../../.env.local src/server.ts",
    "build": "prisma generate && node build.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@myapp/types": "workspace:*",
    "@myapp/utils": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@supabase/supabase-js": "^2.102.1",
    "@trpc/server": "^11.16.0",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.17",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.1",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0"
  }
}
